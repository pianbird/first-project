# MagicTrader - 키움 REST API 자동매매 시스템 환경변수 설정
# PythonAnywhere 환경 변수 설정 또는 로컬 .env 파일에 적용하십시오.

# 키움증권 Open API 모의투자 키 (is_mock=true 시 사용)
KIWOOM_MOCK_APP_KEY="your_mock_app_key_here"
KIWOOM_MOCK_APP_SECRET="your_mock_app_secret_here"

# 키움증권 Open API 실전투자 키 (is_mock=false 및 TRADING_MODE=REAL 시 사용)
KIWOOM_REAL_APP_KEY="your_real_app_key_here"
KIWOOM_REAL_APP_SECRET="your_real_app_secret_here"

# 통합 호환 환경변수 (위 설정이 없거나 기본으로 적용할 키)
KIWOOM_APP_KEY="your_app_key_here"
KIWOOM_APP_SECRET="your_app_secret_here"

# 계좌번호
KIWOOM_ACCOUNT_NO="YOUR_ACCOUNT_NO"

# 자동매매 동작 모드: DISABLED (비활성), MOCK (모의투자 기본값), REAL (실전투자)
# REAL 모드 전환 시에는 환경변수 + config + Dashboard 승인이 모두 맞아야 구동됩니다.
TRADING_MODE="MOCK"

# FastAPI 대시보드 보안 인증 정보
DASHBOARD_USERNAME="admin"
DASHBOARD_PASSWORD="change_this_to_secure_password"
