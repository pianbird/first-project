# ============================================================================
# MagicTrader - Kiwoom REST API Production Environment Variables (.env)
# ============================================================================

# Operating Mode: MOCK (모의투자) or REAL (실전투자)
TRADING_MODE=MOCK

# Kiwoom REST API Common Server URL (Mock: https://mockapi.kiwoom.com, Real: https://api.kiwoom.com)
BASE_URL=https://mockapi.kiwoom.com
KIWOOM_BASE_URL=https://mockapi.kiwoom.com

# Kiwoom REST API Credentials (General / Direct)
APP_KEY=your_app_key_here
SECRET_KEY=your_secret_key_here
KIWOOM_APP_KEY=your_app_key_here
KIWOOM_SECRET_KEY=your_secret_key_here

# Kiwoom REST API Credentials (Mock Trading)
KIWOOM_MOCK_APP_KEY=your_mock_app_key_here
KIWOOM_MOCK_APP_SECRET=your_mock_app_secret_here

# Kiwoom REST API Credentials (Real Trading)
KIWOOM_REAL_APP_KEY=your_real_app_key_here
KIWOOM_REAL_APP_SECRET=your_real_app_secret_here

# Kiwoom Account Number (10 digits, e.g. 8012345601)
ACCOUNT_NO=8012345601
KIWOOM_ACCOUNT_NO=8012345601

# Target Stock Configuration
STOCK_CODE=005930
TARGET_STOCK_CODE=005930
STOCK_NAME=삼성전자
TARGET_STOCK_NAME=삼성전자

# Grid Trading Parameters (Upper/Lower Price, Count, Order Amount)
GRID_LOWER_PRICE=50000
GRID_MIN_PRICE=50000
GRID_UPPER_PRICE=80000
GRID_MAX_PRICE=80000
GRID_COUNT=10
GRID_LEVELS=10
ORDER_AMOUNT_KRW=100000
AMOUNT_PER_LEVEL=100000
GRID_TYPE=ARITHMETIC

# System State File Path
STATE_FILE_PATH=./grid_state.json

# Risk Controls
MAX_DAILY_TRADES=30
MAX_ACCOUNT_EXPOSURE=50000000
SAFE_STOP_DROP_THRESHOLD=0.85

# Telegram Notification Settings
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyZ
TELEGRAM_CHAT_ID=987654321
